# Copy to .env to override the defaults in docker-compose.yml.
POSTGRES_DB=hotelbooking
POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel_dev_password
POSTGRES_PORT=5432

WEB_PORT=3000
API_PORT=8080
# At least 32 characters. Change this for anything beyond a local demo.
JWT_SIGNING_KEY=docker-demo-signing-key-change-me-0123456789

# Seeded front-desk account.
STAFF_EMAIL=staff@hotel.local
STAFF_PASSWORD=Staff123!
